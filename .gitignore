backend/**/*.py[cod]
backend/*.pyo
backend/.venv/
backend/venv/
backend/env/
backend/.pytest_cache/
backend/dist/
backend/build/
backend/*.egg-info/
backend/.mypy_cache/
backend/.ruff_cache/

